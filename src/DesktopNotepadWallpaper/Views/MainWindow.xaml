<hc:Window x:Class="DesktopNotepadWallpaper.Views.MainWindow"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:hc="https://handyorg.github.io/handycontrol"
           xmlns:controls="clr-namespace:DesktopNotepadWallpaper.Controls"
           xmlns:models="clr-namespace:DesktopNotepadWallpaper.Models"
           xmlns:conv="clr-namespace:DesktopNotepadWallpaper.Converters"
           Title="记事壁纸 DesktopNotepadWallpaper"
           Width="1160" Height="780"
           MinWidth="1020" MinHeight="640"
           WindowStartupLocation="CenterScreen"
           FontFamily="Microsoft YaHei UI">

    <hc:Window.Resources>
        <conv:HighlightKeyBrushConverter x:Key="HighlightKeyBrushConverter" />
        <conv:ColorBrushConverter x:Key="ColorBrushConverter" />
        <conv:RowHighlightConverter x:Key="RowHighlightConverter" />
        <conv:SwatchPaletteConverter x:Key="SwatchPaletteConverter" />

        <!-- ==================== 按钮 ==================== -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderLightBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F3F3F7" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 侧边栏导航项（页面）：胶囊高亮 -->
        <Style x:Key="NavItem" TargetType="RadioButton">
            <Setter Property="Height" Value="38" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="9" Padding="12,0">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F3F3F7" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="IsChecked" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoftHoverBrush}" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 侧边栏导航项（动作按钮） -->
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Height" Value="38" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="9" Padding="12,0">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F3F3F7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 无边框无下划线输入框 -->
        <Style x:Key="BareTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CaretBrush" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 行内小按钮 -->
        <Style x:Key="MetaButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MetaToggleButton" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DeleteButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#33E81123" />
                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 多选勾选框：方形蓝勾 -->
        <Style x:Key="SelectionCheckBox" TargetType="CheckBox">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Border x:Name="Box" Width="20" Height="20" CornerRadius="5"
                                    Background="Transparent"
                                    BorderBrush="#C5C5D0" BorderThickness="1.5" />
                            <Path x:Name="Check" Data="M 5 10.5 L 9 14.5 L 15.5 6.5"
                                  Stroke="White" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource PrimaryBrush}" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 完成勾选框：圆形绿勾 -->
        <Style x:Key="CompletionCheckBox" TargetType="CheckBox">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Ellipse x:Name="Box" Width="22" Height="22"
                                     Fill="Transparent"
                                     Stroke="#C5C5D0" StrokeThickness="1.5" />
                            <Path x:Name="Check" Data="M 6.5 11.5 L 10 15 L 16.5 7.5"
                                  Stroke="White" StrokeThickness="2.2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Fill" Value="#4CAF50" />
                                <Setter TargetName="Box" Property="Stroke" Value="#4CAF50" />
                                <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Stroke" Value="#4CAF50" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 托盘菜单样式 -->
        <Style x:Key="TrayContextMenuStyle" TargetType="ContextMenu">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderLightBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="5" />
            <Setter Property="HasDropShadow" Value="True" />
        </Style>
        <Style x:Key="TrayMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="4">
                            <ContentPresenter ContentSource="Header"
                                              RecognizesAccessKey="True"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TraySeparatorStyle" TargetType="Separator">
            <Setter Property="Background" Value="{StaticResource BorderLightBrush}" />
            <Setter Property="Height" Value="1" />
            <Setter Property="Margin" Value="10,5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Rectangle Fill="{TemplateBinding Background}"
                                   Height="{TemplateBinding Height}"
                                   Margin="{TemplateBinding Margin}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 卡片（任务行） -->
        <Style x:Key="TaskCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="Margin" Value="0,5" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderLightBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="1" Direction="270"
                                      Color="#14000000" Opacity="0.5" />
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 手风琴标题按钮：与侧边栏导航同款模式（Button + Click 处理器），渲染与点击均可靠 -->
        <Style x:Key="AccordionHeaderButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 设置表单行 -->
        <Style x:Key="SettingRow" TargetType="DockPanel">
            <Setter Property="Margin" Value="0,0,0,14" />
            <Setter Property="LastChildFill" Value="False" />
        </Style>
        <Style x:Key="SettingLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        </Style>
    </hc:Window.Resources>

    <Grid x:Name="RootGrid" Background="{StaticResource WindowBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="224" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ==================== 侧边栏 ==================== -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBackgroundBrush}"
                BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="18,24,18,26">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="38" Height="38" CornerRadius="10"
                                Background="{StaticResource AccentSoftBrush}">
                            <TextBlock Text="记" FontSize="19" FontWeight="Bold"
                                       Foreground="{StaticResource PrimaryBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="记事壁纸" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="DesktopNotepadWallpaper" FontSize="10"
                                       Foreground="{StaticResource TextMutedBrush}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="18,0,18,22">
                    <Button Style="{StaticResource PrimaryButton}" Height="40"
                            ToolTip="保存全部修改并刷新壁纸"
                            Click="OnNavSaveClick">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="保存" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Margin="10,0">
                    <RadioButton x:Name="NavTask" GroupName="Nav" Style="{StaticResource NavItem}"
                                 IsChecked="True" Checked="OnNavChecked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8FD;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="22" />
                            <TextBlock Text="事件" Margin="4,0,0,0" />
                        </StackPanel>
                    </RadioButton>
                    <Button Style="{StaticResource NavButton}" ToolTip="添加一条新事件"
                            Click="OnNavAddTaskClick">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="22" />
                            <TextBlock Text="添加任务" Margin="4,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButton}" ToolTip="从 Word 文档导入事件"
                            Click="OnNavImportWordClick">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="22" />
                            <TextBlock Text="导入 Word" Margin="4,0,0,0" />
                        </StackPanel>
                    </Button>
                    <RadioButton x:Name="NavGallery" GroupName="Nav" Style="{StaticResource NavItem}"
                                 Checked="OnNavChecked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8B9;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="22" />
                            <TextBlock Text="图库" Margin="4,0,0,0" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavSettings" GroupName="Nav" Style="{StaticResource NavItem}"
                                 Checked="OnNavChecked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="22" />
                            <TextBlock Text="通用设置" Margin="4,0,0,0" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ==================== 主内容区 ==================== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ============ 事件页 ============ -->
            <Grid x:Name="TaskPage" Grid.Row="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Padding="28,20,28,14">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                            <TextBlock Text="我的事件" FontSize="22" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="{Binding StatusText}" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="全选" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                                    Command="{Binding SelectAllCommand}" ToolTip="全选/取消全选所有事件" />
                            <Button Content="删除选中" Style="{StaticResource SecondaryButton}" Margin="0,0,12,0"
                                    IsEnabled="{Binding HasSelection}"
                                    Click="OnDeleteSelectedClick" ToolTip="删除所有勾选的事件" />
                            <Button Content="保存" Style="{StaticResource PrimaryButton}"
                                    Command="{Binding SaveCommand}" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Grid Grid.Row="1">
                    <ScrollViewer x:Name="TaskScroll" Margin="22,4,22,4"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="TaskList" ItemsSource="{Binding Tasks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource TaskCard}"
                                            Background="{Binding HighlightColor, Converter={StaticResource RowHighlightConverter}}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" MaxWidth="520" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- 多选勾选框（方形） -->
                                            <CheckBox Grid.Column="0"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,12,0"
                                                      Style="{StaticResource SelectionCheckBox}"
                                                      ToolTip="勾选后可用「删除选中」批量删除"
                                                      IsChecked="{Binding IsSelected}" />

                                            <!-- 拖拽把手 -->
                                            <TextBlock Grid.Column="1" Text="☰"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,12,0"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       FontSize="18"
                                                       Cursor="SizeAll"
                                                       ToolTip="拖拽调整顺序"
                                                       PreviewMouseLeftButtonDown="OnGripMouseDown"
                                                       PreviewMouseMove="OnGripMouseMove"
                                                       PreviewMouseLeftButtonUp="OnGripMouseUp" />

                                            <!-- 描述（左）+ 标签 -->
                                            <StackPanel Grid.Column="2" Margin="0,0,12,0" VerticalAlignment="Center">
                                                <Grid>
                                                    <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                                             AcceptsReturn="False" TextWrapping="Wrap"
                                                             MinHeight="0" FontSize="16"
                                                             Foreground="{StaticResource TextPrimaryBrush}">
                                                        <TextBox.Style>
                                                            <Style TargetType="TextBox" BasedOn="{StaticResource BareTextBox}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBox.Style>
                                                    </TextBox>
                                                    <TextBlock Text="{Binding Description}"
                                                               TextWrapping="Wrap"
                                                               TextDecorations="Strikethrough"
                                                               Foreground="{StaticResource TextMutedBrush}"
                                                               FontSize="16"
                                                               IsHitTestVisible="False">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                                <Grid HorizontalAlignment="Left" Margin="0,4,0,0">
                                                    <ToggleButton x:Name="TagToggle"
                                                                  Style="{StaticResource MetaToggleButton}"
                                                                  ToolTip="编辑标签">
                                                        <TextBlock FontSize="13">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Text" Value="{Binding TagText, StringFormat=# {0}}" />
                                                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding TagText}" Value="">
                                                                            <Setter Property="Text" Value="＋ 标签" />
                                                                            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </ToggleButton>
                                                    <Popup PlacementTarget="{Binding ElementName=TagToggle}"
                                                           Placement="Bottom"
                                                           StaysOpen="False"
                                                           AllowsTransparency="True"
                                                           PopupAnimation="Fade"
                                                           IsOpen="{Binding IsChecked, ElementName=TagToggle, Mode=TwoWay}">
                                                        <Border Background="{StaticResource CardBackgroundBrush}"
                                                                BorderBrush="{StaticResource BorderLightBrush}"
                                                                BorderThickness="1" CornerRadius="10" Padding="12">
                                                            <StackPanel>
                                                                <TextBlock Text="标签（多个用空格或逗号分隔）"
                                                                           FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                                                                <TextBox Width="240" FontSize="13"
                                                                         Text="{Binding TagText, UpdateSourceTrigger=LostFocus}"
                                                                         hc:InfoElement.Placeholder="输入标签（空格或逗号分隔）" />
                                                                <Button Content="完成" Height="30" MinWidth="72"
                                                                        Margin="0,10,0,0" HorizontalAlignment="Right"
                                                                        Style="{StaticResource PrimaryButton}"
                                                                        Click="OnTagDoneClick" />
                                                            </StackPanel>
                                                        </Border>
                                                    </Popup>
                                                </Grid>
                                            </StackPanel>

                                            <!-- 截止时间（事件右侧） -->
                                            <hc:DateTimePicker Grid.Column="3"
                                                               Width="170"
                                                               VerticalAlignment="Center"
                                                               FontSize="13"
                                                               Height="34"
                                                               DateTimeFormat="yyyy-MM-dd HH:mm"
                                                               SelectedDateTime="{Binding Deadline, Mode=TwoWay}"
                                                               hc:InfoElement.Placeholder="截止时间"
                                                               ToolTip="点击选择截止日期和时间" />

                                            <!-- 高亮颜色 -->
                                            <Grid Grid.Column="4" VerticalAlignment="Center" Margin="12,0,12,0">
                                                <ToggleButton x:Name="SwatchToggle"
                                                              Width="30" Height="30"
                                                              Cursor="Hand"
                                                              ToolTip="高亮颜色"
                                                              IsChecked="{Binding IsPaletteOpen, Mode=TwoWay}">
                                                    <ToggleButton.Template>
                                                        <ControlTemplate TargetType="ToggleButton">
                                                            <Grid>
                                                                <Ellipse x:Name="Dot"
                                                                         Fill="{Binding HighlightColor, Converter={StaticResource HighlightKeyBrushConverter}}"
                                                                         Stroke="{StaticResource BorderLightBrush}"
                                                                         StrokeThickness="2" />
                                                            </Grid>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Dot" Property="Stroke" Value="{StaticResource PrimaryBrush}" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </ToggleButton.Template>
                                                </ToggleButton>
                                                <Popup PlacementTarget="{Binding ElementName=SwatchToggle}"
                                                       Placement="Bottom"
                                                       StaysOpen="False"
                                                       AllowsTransparency="True"
                                                       PopupAnimation="Fade"
                                                       IsOpen="{Binding IsPaletteOpen, Mode=TwoWay}">
                                                    <Border Background="{StaticResource CardBackgroundBrush}"
                                                            BorderBrush="{StaticResource BorderLightBrush}"
                                                            BorderThickness="1" CornerRadius="10" Padding="8">
                                                        <ItemsControl ItemsSource="{Binding Converter={StaticResource SwatchPaletteConverter}}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <UniformGrid Columns="4" />
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Button Tag="{Binding}"
                                                                            ToolTip="{Binding Display}"
                                                                            Click="OnSwatchClick"
                                                                            Background="Transparent"
                                                                            BorderThickness="0"
                                                                            Margin="3" Padding="4"
                                                                            Cursor="Hand">
                                                                        <Ellipse Width="18" Height="18"
                                                                                 Fill="{Binding Color, Converter={StaticResource ColorBrushConverter}}"
                                                                                 Stroke="{StaticResource BorderLightBrush}"
                                                                                 StrokeThickness="1" />
                                                                    </Button>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </Border>
                                                </Popup>
                                            </Grid>

                                            <!-- 完成勾选框（圆形，颜色右侧） -->
                                            <CheckBox Grid.Column="5"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,12,0"
                                                      Style="{StaticResource CompletionCheckBox}"
                                                      ToolTip="勾选表示事件已完成"
                                                      IsChecked="{Binding IsCompleted}" />

                                            <!-- X 删除 -->
                                            <Button Grid.Column="6" Content="✕"
                                                    VerticalAlignment="Center"
                                                    Style="{StaticResource DeleteButton}"
                                                    ToolTip="删除事件"
                                                    Command="{Binding DataContext.DeleteTaskCommand, RelativeSource={RelativeSource AncestorType={x:Type hc:Window}}}"
                                                    CommandParameter="{Binding}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- 空状态提示 -->
                    <TextBlock Text="暂无事件，点击左侧「添加任务」开始记录"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{StaticResource TextMutedBrush}" FontSize="14"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Tasks.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Grid>

            <!-- ============ 图库页 ============ -->
            <Grid x:Name="GalleryPage" Grid.Row="0" Visibility="Collapsed"
                  DataContext="{Binding Settings}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Padding="28,20,28,14">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                            <TextBlock Text="图库" FontSize="22" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="导入喜欢的图片，作为轮播壁纸（最多 20 张）" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding CountText}"
                                       VerticalAlignment="Center" Margin="0,0,14,0"
                                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" />
                            <Button Content="导入图片" Style="{StaticResource PrimaryButton}"
                                    Command="{Binding ImportCommand}" />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <ListBox x:Name="GalleryList" Grid.Row="1" Margin="22,4,22,12"
                         ItemsSource="{Binding Gallery}"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         PreviewMouseLeftButtonDown="OnGalleryPreviewMouseDown"
                         PreviewMouseMove="OnGalleryPreviewMouseMove"
                         PreviewMouseLeftButtonUp="OnGalleryPreviewMouseUp">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Width="160" Margin="6" Padding="6"
                                    Background="{StaticResource CardBackgroundBrush}"
                                    BorderBrush="{StaticResource BorderLightBrush}"
                                    BorderThickness="1" CornerRadius="10">
                                <StackPanel>
                                    <Grid ClipToBounds="True" Height="100">
                                        <Image Stretch="UniformToFill"
                                               Width="148" Height="100"
                                               Tag="{Binding FullPath}"
                                               Loaded="OnGalleryThumbLoaded" />
                                        <Button Content="✕"
                                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                                Margin="0,4,4,0"
                                                Width="24" Height="24" FontSize="12"
                                                Foreground="White"
                                                BorderThickness="0" Cursor="Hand"
                                                ToolTip="删除图片"
                                                Command="{Binding DataContext.DeleteImageCommand, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}"
                                                CommandParameter="{Binding}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Bd" Background="#B3222222" CornerRadius="12">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource DangerBrush}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </Grid>
                                    <TextBlock Text="{Binding FileName}"
                                               FontSize="11"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="2,6,0,0" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <!-- ============ 设置页 ============ -->
            <Grid x:Name="SettingsPage" Grid.Row="0" Visibility="Collapsed"
                  DataContext="{Binding Settings}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Padding="28,20,28,14">
                    <StackPanel>
                        <TextBlock Text="通用设置" FontSize="22" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="调整壁纸背景、字体与系统选项，修改即时生效" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="24,8,24,20" MaxWidth="680" HorizontalAlignment="Left">

                        <Border Background="{StaticResource CardBackgroundBrush}" CornerRadius="10"
                                BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1"
                                Margin="0,0,0,12">
                            <StackPanel>
                                <Button x:Name="BackgroundHeader" Style="{StaticResource AccordionHeaderButton}"
                                        Tag="Background" Click="OnAccordionHeaderClick">
                                    <DockPanel Margin="18,14" LastChildFill="False">
                                        <StackPanel DockPanel.Dock="Left">
                                            <TextBlock Text="背景样式" FontSize="15" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}" />
                                            <TextBlock Text="壁纸背景的类型、颜色与内边距" FontSize="12"
                                                       Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0" />
                                        </StackPanel>
                                        <TextBlock x:Name="BackgroundChevron" DockPanel.Dock="Right"
                                                   VerticalAlignment="Center"
                                                   Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   RenderTransformOrigin="0.5,0.5">
                                            <TextBlock.RenderTransform>
                                                <RotateTransform Angle="0" />
                                            </TextBlock.RenderTransform>
                                        </TextBlock>
                                    </DockPanel>
                                </Button>
                                <Grid x:Name="BackgroundContent" Visibility="Collapsed" Margin="18,0,18,18">
                                    <StackPanel>
                                <TextBlock Text="背景类型" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10" />
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <RadioButton Content="纯色" GroupName="BgStyle" IsChecked="{Binding IsSolidStyle}" />
                                    <RadioButton Content="渐变" GroupName="BgStyle" Margin="20,0,0,0" IsChecked="{Binding IsGradientStyle}" />
                                    <RadioButton Content="模糊图片" GroupName="BgStyle" Margin="20,0,0,0" IsChecked="{Binding IsImageBlurStyle}" />
                                </StackPanel>

                                <DockPanel Style="{StaticResource SettingRow}">
                                    <TextBlock Text="纯色颜色" Style="{StaticResource SettingLabel}" DockPanel.Dock="Left" Width="110" />
                                    <controls:ColorSwatchPicker SelectedBrush="{Binding SolidColorBrush, Mode=TwoWay}" />
                                </DockPanel>
                                <DockPanel Style="{StaticResource SettingRow}">
                                    <TextBlock Text="渐变起始色" Style="{StaticResource SettingLabel}" DockPanel.Dock="Left" Width="110" />
                                    <controls:ColorSwatchPicker SelectedBrush="{Binding GradientStartBrush, Mode=TwoWay}" />
                                </DockPanel>
                                <DockPanel Style="{StaticResource SettingRow}">
                                    <TextBlock Text="渐变结束色" Style="{StaticResource SettingLabel}" DockPanel.Dock="Left" Width="110" />
                                    <controls:ColorSwatchPicker SelectedBrush="{Binding GradientEndBrush, Mode=TwoWay}" />
                                </DockPanel>

                                <DockPanel Style="{StaticResource SettingRow}">
                                    <TextBlock Text="背景图片" Style="{StaticResource SettingLabel}" DockPanel.Dock="Left" Width="110" />
                                    <Button Content="选择图片" Style="{StaticResource SecondaryButton}"
                                            Command="{Binding PickBackgroundImageCommand}" />
                                    <TextBlock Text="{Binding BgImageName}"
                                               VerticalAlignment="Center" Margin="12,0,0,0"
                                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"
                                               MaxWidth="240" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                                <DockPanel Style="{StaticResource SettingRow}">
                                    <TextBlock Text="模糊程度" Style="{StaticResource SettingLabel}" DockPanel.Dock="Left" Width="110" />
                                    <Slider Width="220" Minimum="0" Maximum="60"
                                            IsSnapToTickEnabled="True" TickFrequency="1"
                                            Value="{Binding BlurRadius}" />
                                </DockPanel>

                                <Separator Margin="0,4,0,12" Background="{StaticResource BorderLightBrush}" />
                                <TextBlock Text="内容内边距（壁纸文字与边缘的距离）" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10" />
                                <DockPanel Style="{StaticResource SettingRow}">
                                    <TextBlock Text="上边距" Style="{StaticResource SettingLabel}" DockPanel.Dock="Left" Width="110" />
                                    <Slider Width="220" Minimum="20" Maximum="{Binding MaxVerticalPadding}"
                                            IsSnapToTickEnabled="True" TickFrequency="2"
                                            Value="{Binding PaddingTop}" />
                                </DockPanel>
                                <DockPanel Style="{StaticResource SettingRow}">
                                    <TextBlock Text="下边距" Style="{StaticResource SettingLabel}" DockPanel.Dock="Left" Width="110" />
                                    <Slider Width="220" Minimum="20" Maximum="{Binding MaxVerticalPadding}"
                                            IsSnapToTickEnabled="True" TickFrequency="2"
                                            Value="{Binding PaddingBottom}" />
                                </DockPanel>
                                <DockPanel Style="{StaticResource SettingRow}">
                                    <TextBlock Text="左边距" Style="{StaticResource SettingLabel}" DockPanel.Dock="Left" Width="110" />
                                    <Slider Width="220" Minimum="20" Maximum="{Binding MaxHorizontalPadding}"
                                            IsSnapToTickEnabled="True" TickFrequency="2"
                                            Value="{Binding PaddingLeft}" />
                                </DockPanel>
                                <DockPanel Style="{StaticResource SettingRow}">
                                    <TextBlock Text="右边距" Style="{StaticResource SettingLabel}" DockPanel.Dock="Left" Width="110" />
                                    <Slider Width="220" Minimum="20" Maximum="{Binding MaxHorizontalPadding}"
                                            IsSnapToTickEnabled="True" TickFrequency="2"
                                            Value="{Binding PaddingRight}" />
                                    </DockPanel>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource CardBackgroundBrush}" CornerRadius="10"
                                BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1"
                                Margin="0,0,0,12">
                            <StackPanel>
                                <Button x:Name="FontHeader" Style="{StaticResource AccordionHeaderButton}"
                                        Tag="Font" Click="OnAccordionHeaderClick">
                                    <DockPanel Margin="18,14" LastChildFill="False">
                                        <StackPanel DockPanel.Dock="Left">
                                            <TextBlock Text="字体" FontSize="15" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}" />
                                            <TextBlock Text="壁纸文字的字体、字号与颜色" FontSize="12"
                                                       Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0" />
                                        </StackPanel>
                                        <TextBlock x:Name="FontChevron" DockPanel.Dock="Right"
                                                   VerticalAlignment="Center"
                                                   Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   RenderTransformOrigin="0.5,0.5">
                                            <TextBlock.RenderTransform>
                                                <RotateTransform Angle="0" />
                                            </TextBlock.RenderTransform>
                                        </TextBlock>
                                    </DockPanel>
                                </Button>
                                <Grid x:Name="FontContent" Visibility="Collapsed" Margin="18,0,18,18">
                                    <StackPanel>
                                <DockPanel Style="{StaticResource SettingRow}">
                                    <TextBlock Text="字体" Style="{StaticResource SettingLabel}" DockPanel.Dock="Left" Width="110" />
                                    <ComboBox Width="240"
                                              ItemsSource="{Binding FontFamilies}"
                                              SelectedItem="{Binding SelectedFontFamily}" />
                                </DockPanel>
                                <DockPanel Style="{StaticResource SettingRow}">
                                    <TextBlock Text="字号" Style="{StaticResource SettingLabel}" DockPanel.Dock="Left" Width="110" />
                                    <Slider Width="220" Minimum="16" Maximum="44"
                                            IsSnapToTickEnabled="True" TickFrequency="1"
                                            Value="{Binding BaseFontSize}" />
                                </DockPanel>
                                <DockPanel Style="{StaticResource SettingRow}">
                                    <TextBlock Text="字体颜色" Style="{StaticResource SettingLabel}" DockPanel.Dock="Left" Width="110" />
                                    <controls:ColorSwatchPicker SelectedBrush="{Binding FontColorBrush, Mode=TwoWay}" />
                                </DockPanel>
                                <TextBlock Text="内容超过一屏时字号会自动缩小"
                                           Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,6,0,0" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource CardBackgroundBrush}" CornerRadius="10"
                                BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1"
                                Margin="0,0,0,12">
                            <StackPanel>
                                <Button x:Name="SystemHeader" Style="{StaticResource AccordionHeaderButton}"
                                        Tag="System" Click="OnAccordionHeaderClick">
                                    <DockPanel Margin="18,14" LastChildFill="False">
                                        <StackPanel DockPanel.Dock="Left">
                                            <TextBlock Text="系统" FontSize="15" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}" />
                                            <TextBlock Text="开机自启、托盘行为与数据管理" FontSize="12"
                                                       Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0" />
                                        </StackPanel>
                                        <TextBlock x:Name="SystemChevron" DockPanel.Dock="Right"
                                                   VerticalAlignment="Center"
                                                   Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   RenderTransformOrigin="0.5,0.5">
                                            <TextBlock.RenderTransform>
                                                <RotateTransform Angle="0" />
                                            </TextBlock.RenderTransform>
                                        </TextBlock>
                                    </DockPanel>
                                </Button>
                                <Grid x:Name="SystemContent" Visibility="Collapsed" Margin="18,0,18,18">
                                    <StackPanel>
                                <DockPanel Style="{StaticResource SettingRow}">
                                    <TextBlock Text="开机自启" Style="{StaticResource SettingLabel}" DockPanel.Dock="Left" Width="110" />
                                    <ToggleButton Style="{StaticResource ToggleButtonSwitch}"
                                                  IsChecked="{Binding AutoStart}" />
                                </DockPanel>
                                <DockPanel Style="{StaticResource SettingRow}">
                                    <TextBlock Text="最小化到托盘" Style="{StaticResource SettingLabel}" DockPanel.Dock="Left" Width="110" />
                                    <ToggleButton Style="{StaticResource ToggleButtonSwitch}"
                                                  IsChecked="{Binding MinimizeToTray}" />
                                </DockPanel>
                                <Separator Margin="0,6,0,16" Background="{StaticResource BorderLightBrush}" />
                                <TextBlock Text="数据管理" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10" />
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="备份数据" Style="{StaticResource SecondaryButton}"
                                            Command="{Binding BackupCommand}" />
                                    <Button Content="恢复默认设置" Style="{StaticResource SecondaryButton}" Margin="12,0,0,0"
                                            Command="{Binding ResetDefaultsCommand}" />
                                </StackPanel>
                                <TextBlock Text="备份包含任务、配置与图库图片；恢复默认会清空全部数据"
                                           Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,8,0,0" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource CardBackgroundBrush}" CornerRadius="10"
                                BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1"
                                Margin="0,0,0,12">
                            <StackPanel>
                                <Button x:Name="AboutHeader" Style="{StaticResource AccordionHeaderButton}"
                                        Tag="About" Click="OnAccordionHeaderClick">
                                    <DockPanel Margin="18,14" LastChildFill="False">
                                        <StackPanel DockPanel.Dock="Left">
                                            <TextBlock Text="关于" FontSize="15" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}" />
                                            <TextBlock Text="版本与隐私说明" FontSize="12"
                                                       Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0" />
                                        </StackPanel>
                                        <TextBlock x:Name="AboutChevron" DockPanel.Dock="Right"
                                                   VerticalAlignment="Center"
                                                   Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   RenderTransformOrigin="0.5,0.5">
                                            <TextBlock.RenderTransform>
                                                <RotateTransform Angle="0" />
                                            </TextBlock.RenderTransform>
                                        </TextBlock>
                                    </DockPanel>
                                </Button>
                                <Grid x:Name="AboutContent" Visibility="Collapsed" Margin="18,0,18,18">
                                    <StackPanel>
                                <TextBlock Text="记事壁纸 DesktopNotepadWallpaper"
                                           FontSize="15" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="{Binding VersionText}"
                                           FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,0" />
                                <TextBlock Text="全部数据保存在本地 Data 目录，不联网不上传"
                                           FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,10,0,0" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ============ 状态栏 ============ -->
            <Border Grid.Row="1" Background="{StaticResource CardBackgroundBrush}"
                    BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Margin="28,9" FontSize="12"
                               Foreground="{StaticResource TextMutedBrush}"
                               Text="全部数据保存在本地 Data 目录" />
                    <TextBlock Grid.Column="1" Margin="0,9,28,9" FontSize="12"
                               Foreground="{StaticResource TextMutedBrush}"
                               Text="Ctrl + Shift + Alt + ←/→ 切换壁纸 · ↑ 回到记事本" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</hc:Window>
