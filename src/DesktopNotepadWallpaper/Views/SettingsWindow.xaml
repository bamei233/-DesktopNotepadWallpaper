<hc:Window x:Class="DesktopNotepadWallpaper.Views.SettingsWindow"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:hc="https://handyorg.github.io/handycontrol"
           xmlns:controls="clr-namespace:DesktopNotepadWallpaper.Controls"
           xmlns:conv="clr-namespace:DesktopNotepadWallpaper.Converters"
           Title="设置"
           Width="780" Height="580"
           MinWidth="660" MinHeight="460"
           WindowStartupLocation="CenterOwner">

    <hc:Window.Resources>
        <conv:GalleryThumbConverter x:Key="ThumbConverter" />

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <Style x:Key="SettingRow" TargetType="DockPanel">
            <Setter Property="Margin" Value="0,0,0,14" />
            <Setter Property="LastChildFill" Value="False" />
        </Style>

        <Style x:Key="SettingLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <!-- 缩略图右上角删除按钮 -->
        <Style x:Key="ThumbDeleteButton" TargetType="Button">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="#B3222222" CornerRadius="11">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E81123" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </hc:Window.Resources>

    <TabControl x:Name="SettingsTabs" Margin="12">
        <!-- ==================== 图库管理 ==================== -->
        <TabItem Header="图库管理">
            <DockPanel Margin="12">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                    <Button Content="导入图片"
                            Style="{DynamicResource ButtonPrimary}"
                            Command="{Binding ImportCommand}" />
                    <TextBlock Text="{Binding CountText}"
                               VerticalAlignment="Center"
                               Margin="14,0,0,0"
                               FontSize="13" />
                </StackPanel>
                <ListBox x:Name="GalleryList"
                         ItemsSource="{Binding Gallery}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         PreviewMouseLeftButtonDown="OnGalleryPreviewMouseDown"
                         PreviewMouseMove="OnGalleryPreviewMouseMove"
                         PreviewMouseLeftButtonUp="OnGalleryPreviewMouseUp">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Width="150" Margin="6" Padding="5"
                                    Background="{DynamicResource RegionBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="6">
                                <StackPanel>
                                    <Grid ClipToBounds="True" Height="95">
                                        <Image Source="{Binding FullPath, Converter={StaticResource ThumbConverter}}"
                                               Width="140" Height="95"
                                               Stretch="UniformToFill" />
                                        <Button Content="✕"
                                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                                Margin="0,4,4,0"
                                                Style="{StaticResource ThumbDeleteButton}"
                                                ToolTip="删除图片"
                                                Command="{Binding DataContext.DeleteImageCommand, RelativeSource={RelativeSource AncestorType={x:Type hc:Window}}}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                    <TextBlock Text="{Binding FileName}"
                                               FontSize="11"
                                               Foreground="#9AA7B5"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="2,6,0,0" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </TabItem>

        <!-- ==================== 背景样式 ==================== -->
        <TabItem Header="背景样式">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="16" MaxWidth="560">
                    <TextBlock Text="背景类型" Style="{StaticResource SectionTitle}" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <RadioButton Content="纯色" GroupName="BgStyle" IsChecked="{Binding IsSolidStyle}" />
                        <RadioButton Content="渐变" GroupName="BgStyle" Margin="20,0,0,0" IsChecked="{Binding IsGradientStyle}" />
                        <RadioButton Content="模糊图片" GroupName="BgStyle" Margin="20,0,0,0" IsChecked="{Binding IsImageBlurStyle}" />
                    </StackPanel>

                    <DockPanel Style="{StaticResource SettingRow}">
                        <TextBlock Text="纯色颜色" Style="{StaticResource SettingLabel}" DockPanel.Dock="Left" Width="120" />
                        <controls:ColorSwatchPicker SelectedBrush="{Binding SolidColorBrush, Mode=TwoWay}" />
                    </DockPanel>

                    <DockPanel Style="{StaticResource SettingRow}">
                        <TextBlock Text="渐变起始色" Style="{StaticResource SettingLabel}" DockPanel.Dock="Left" Width="120" />
                        <controls:ColorSwatchPicker SelectedBrush="{Binding GradientStartBrush, Mode=TwoWay}" />
                    </DockPanel>

                    <DockPanel Style="{StaticResource SettingRow}">
                        <TextBlock Text="渐变结束色" Style="{StaticResource SettingLabel}" DockPanel.Dock="Left" Width="120" />
                        <controls:ColorSwatchPicker SelectedBrush="{Binding GradientEndBrush, Mode=TwoWay}" />
                    </DockPanel>

                    <DockPanel Style="{StaticResource SettingRow}">
                        <TextBlock Text="背景图片" Style="{StaticResource SettingLabel}" DockPanel.Dock="Left" Width="120" />
                        <Button Content="选择图片" Command="{Binding PickBackgroundImageCommand}" />
                        <TextBlock Text="{Binding BgImageName}"
                                   VerticalAlignment="Center" Margin="12,0,0,0"
                                   Foreground="#9AA7B5" FontSize="12"
                                   MaxWidth="280" TextTrimming="CharacterEllipsis" />
                    </DockPanel>

                    <DockPanel Style="{StaticResource SettingRow}">
                        <TextBlock Text="模糊程度" Style="{StaticResource SettingLabel}" DockPanel.Dock="Left" Width="120" />
                        <Slider Width="220" Minimum="0" Maximum="60"
                                IsSnapToTickEnabled="True" TickFrequency="1"
                                Value="{Binding BlurRadius}" />
                    </DockPanel>

                    <Separator Margin="0,4,0,12" />
                    <TextBlock Text="内容内边距（壁纸文字与边缘的距离）" Style="{StaticResource SectionTitle}" />

                    <DockPanel Style="{StaticResource SettingRow}">
                        <TextBlock Text="上边距" Style="{StaticResource SettingLabel}" DockPanel.Dock="Left" Width="120" />
                        <Slider Width="220" Minimum="20" Maximum="240"
                                IsSnapToTickEnabled="True" TickFrequency="2"
                                Value="{Binding PaddingTop}" />
                    </DockPanel>

                    <DockPanel Style="{StaticResource SettingRow}">
                        <TextBlock Text="下边距" Style="{StaticResource SettingLabel}" DockPanel.Dock="Left" Width="120" />
                        <Slider Width="220" Minimum="20" Maximum="240"
                                IsSnapToTickEnabled="True" TickFrequency="2"
                                Value="{Binding PaddingBottom}" />
                    </DockPanel>

                    <DockPanel Style="{StaticResource SettingRow}">
                        <TextBlock Text="左边距" Style="{StaticResource SettingLabel}" DockPanel.Dock="Left" Width="120" />
                        <Slider Width="220" Minimum="20" Maximum="240"
                                IsSnapToTickEnabled="True" TickFrequency="2"
                                Value="{Binding PaddingLeft}" />
                    </DockPanel>

                    <DockPanel Style="{StaticResource SettingRow}">
                        <TextBlock Text="右边距" Style="{StaticResource SettingLabel}" DockPanel.Dock="Left" Width="120" />
                        <Slider Width="220" Minimum="20" Maximum="240"
                                IsSnapToTickEnabled="True" TickFrequency="2"
                                Value="{Binding PaddingRight}" />
                    </DockPanel>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- ==================== 字体 ==================== -->
        <TabItem Header="字体">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="16" MaxWidth="560">
                    <DockPanel Style="{StaticResource SettingRow}">
                        <TextBlock Text="字体" Style="{StaticResource SettingLabel}" DockPanel.Dock="Left" Width="120" />
                        <ComboBox Width="240"
                                  ItemsSource="{Binding FontFamilies}"
                                  SelectedItem="{Binding SelectedFontFamily}" />
                    </DockPanel>

                    <DockPanel Style="{StaticResource SettingRow}">
                        <TextBlock Text="字号" Style="{StaticResource SettingLabel}" DockPanel.Dock="Left" Width="120" />
                        <Slider Width="220" Minimum="16" Maximum="44"
                                IsSnapToTickEnabled="True" TickFrequency="1"
                                Value="{Binding BaseFontSize}" />
                    </DockPanel>

                    <DockPanel Style="{StaticResource SettingRow}">
                        <TextBlock Text="字体颜色" Style="{StaticResource SettingLabel}" DockPanel.Dock="Left" Width="120" />
                        <controls:ColorSwatchPicker SelectedBrush="{Binding FontColorBrush, Mode=TwoWay}" />
                    </DockPanel>

                    <TextBlock Text="内容超过一屏时字号会自动缩小"
                               Foreground="#6B7785" FontSize="12" Margin="0,6,0,0" />
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- ==================== 系统 ==================== -->
        <TabItem Header="系统">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="16" MaxWidth="560">
                    <DockPanel Style="{StaticResource SettingRow}">
                        <TextBlock Text="开机自启" Style="{StaticResource SettingLabel}" DockPanel.Dock="Left" Width="120" />
                        <ToggleButton Style="{StaticResource ToggleButtonSwitch}"
                                      IsChecked="{Binding AutoStart}" />
                    </DockPanel>

                    <DockPanel Style="{StaticResource SettingRow}">
                        <TextBlock Text="最小化到托盘" Style="{StaticResource SettingLabel}" DockPanel.Dock="Left" Width="120" />
                        <ToggleButton Style="{StaticResource ToggleButtonSwitch}"
                                      IsChecked="{Binding MinimizeToTray}" />
                    </DockPanel>

                    <Separator Margin="0,6,0,16" />

                    <TextBlock Text="数据管理" Style="{StaticResource SectionTitle}" />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="备份数据" Command="{Binding BackupCommand}" />
                        <Button Content="恢复默认设置" Margin="12,0,0,0" Command="{Binding ResetDefaultsCommand}" />
                    </StackPanel>
                    <TextBlock Text="备份包含任务、配置与图库图片；恢复默认会清空全部数据"
                               Foreground="#6B7785" FontSize="12" Margin="0,8,0,0" />
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- ==================== 关于 ==================== -->
        <TabItem Header="关于">
            <StackPanel Margin="16" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="记事壁纸 DesktopNotepadWallpaper"
                           FontSize="18" FontWeight="SemiBold"
                           HorizontalAlignment="Center" />
                <TextBlock Text="{Binding VersionText}"
                           FontSize="13" Foreground="#9AA7B5"
                           HorizontalAlignment="Center" Margin="0,8,0,0" />
                <TextBlock Text="记事本 + 图库合成桌面壁纸 · C# / WPF / .NET 8"
                           FontSize="12" Foreground="#6B7785"
                           HorizontalAlignment="Center" Margin="0,12,0,0" />
                <TextBlock Text="全部数据保存在本地 Data 目录，不联网不上传"
                           FontSize="12" Foreground="#6B7785"
                           HorizontalAlignment="Center" Margin="0,4,0,0" />
            </StackPanel>
        </TabItem>
    </TabControl>
</hc:Window>
